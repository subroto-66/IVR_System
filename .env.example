APP_NAME="IVR System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivr_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_VALIDATION=false

# Storage Configuration (NO AWS REQUIRED)
# Option 1 (Default): Serve from your server via public storage symlink (100% free, zero external services)
FILESYSTEM_DISK=public

# Option 2 (Cloudflare R2 - S3-compatible, NO AWS, 0 egress fees):
# FILESYSTEM_DISK=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_URL=https://pub-<id>.r2.dev

MAIL_MAILER=log
